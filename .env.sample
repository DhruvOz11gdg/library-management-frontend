# ============================================================================
# alankar-premium-jewelry-landing-page — .env.sample
# Copy to `.env` (cmd: `copy .env.sample .env`) and adjust. Restart the dev
# server after editing — Vite reads .env only at boot.
#
# Only VITE_* variables exist here, and they are PUBLIC (inlined into the JS
# bundle). Never put the ImgBB key or any secret in this repo — image uploads
# go frontend → backend → ImgBB, and only the backend holds that key.
# ============================================================================

# The backend API base URL.
#   Local dev (recommended):  /api
#     → Vite's dev proxy forwards /api/* to http://127.0.0.1:5001/v1
#       (see vite.config.ts; override target with ALANKAR_API_PROXY_TARGET).
#   Production build:         https://api.alankar.me/v1
#     → direct calls; make sure the backend's CORS_ORIGIN includes the site.
VITE_API_BASE_URL=/api

# The store's WhatsApp number in international format, digits only — no "+",
# no spaces. e.g. for +91 95861 71580 → 919586171580.
# The cart's "Checkout securely" button opens wa.me with the order message.
VITE_WHATSAPP_NUMBER=919586171580
